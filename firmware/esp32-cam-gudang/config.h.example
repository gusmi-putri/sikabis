#pragma once

const char* WIFI_SSID     = "ISI_NAMA_WIFI";
const char* WIFI_PASSWORD = "ISI_PASSWORD_WIFI";

// Dari @BotFather (token) dan @userinfobot (chat ID).
const char* BOT_TOKEN_VAL = "ISI_TOKEN_BOT_TELEGRAM";
const char* CHAT_ID_VAL   = "ISI_CHAT_ID_TELEGRAM";

// IP LAN komputer server Laravel (BUKAN "localhost" -- ESP32 tidak bisa
// mengaksesnya). Dengan Laragon (Apache port 80) formatnya:
// http://<IP-server>/sikabis/public/api
const char* API_BASE_URL_VAL = "http://192.168.1.XXX/sikabis/public/api";
const char* DEVICE_ID_VAL    = "GUDANG-01";

// Disalin dari kolom `api_key` tabel device_statuses.
const char* DEVICE_API_KEY_VAL = "ISI_API_KEY_DARI_DATABASE";

// Kunci akses live stream (?key=...). Bebas diisi, minimal 16 karakter
// acak tanpa spasi. Dashboard web menerimanya otomatis lewat heartbeat.
const char* STREAM_KEY_VAL = "ISI_KUNCI_STREAM_ACAK";
